{
  "name": "nexus",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up",
    "dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "down": "docker compose -f docker-compose.dev.yml down",
    "dev:auth": "npm --workspace=apps/auth-service run dev",
    "dev:user": "npm --workspace=apps/user-service run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "tsc -b",
    "build:packages": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules dist",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "eslint": "^9.39.3",
    "prettier": "^3.8.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
