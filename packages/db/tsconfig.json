{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "declaration": true, // Required for composite
    "declarationMap": true // Optional: helps with Go To Definition
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
