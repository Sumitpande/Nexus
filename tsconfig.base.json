{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@nexus/db": ["./packages/db/src"],
      "@nexus/redis": ["./packages/redis/src"],
      "@nexus/errors": ["./packages/errors/src"],
      "@nexus/auth-client": ["./packages/auth-client/src"],
      "@nexus/kafka": ["./packages/kafka/src"]
    }
  },
  "exclude": ["**/node_modules", "**/dist"]
}
